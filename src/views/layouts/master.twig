{#
  Nimo Matcha — master layout (Salla Twilight, built on Raed).
  Shared variables: store, theme, user, page, language (see Raed's documentation table).
  Raed's assets stay loaded so every page this theme doesn't redesign (account, orders, blog, brands,
  thank-you…) keeps working; the Nimo shell (nm-app.css / nm-app.js) sits on top.
#}
<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#FFFFFF">
    {{ theme.settings.set('placeholder', 'images/placeholder.png') }}

    {% if __preview is not defined %}
        {# Raed's web components used across the store's other pages #}
        <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'product-card.js'|asset }}"></script>
        <script defer src="{{ 'main-menu.js'|asset }}"></script>
    {% endif %}

    {% block head_scripts %}{% endblock %}

    <script data-cfasync="false">
        {# globals Raed's app.js reads #}
        window.header_is_sticky = "";
        window.imageZoom = "{{ theme.settings.get('imageZoom') }}";
        window.can_access_wallet = {{ user.can_access_wallet ? 'true' : 'false' }};
        window.enable_more_menu = "";
        window.enable_add_product_toast = "";
        window.notify_when_available_in_card = "{{ theme.settings.get('notify_when_available_in_card', true) }}";

        window.NM_SETTINGS = {
            sound: {{ theme.settings.get('enable_sound', true) ? 'true' : 'false' }},
            cups: {{ theme.settings.get('show_cost_per_cup', true) ? 'true' : 'false' }},
            gramsPerCup: {{ theme.settings.get('grams_per_cup', 2) ?: 2 }},
            cartUrl: "{{ link('cart') }}",
            i18n: {
                added: "{{ trans('nm.added') }}",
                viewCart: "{{ trans('nm.view_cart') }}",
                remove: "{{ trans('nm.remove') }}",
                increase: "{{ trans('nm.increase') }}",
                decrease: "{{ trans('nm.decrease') }}",
                add: "{{ trans('nm.add') }}",
                addToCart: "{{ trans('nm.add_to_cart') }}",
                addedShort: "{{ trans('nm.added_short') }}",
                soldOut: "{{ trans('nm.sold_out') }}",
                save: "{{ trans('nm.save') }}",
                cups: "{{ trans('nm.cups_short') }}",
                perCup: "{{ trans('nm.per_cup') }}",
                freeLeft: "{{ trans('nm.free_shipping_left') }}",
                freeDone: "{{ trans('nm.free_shipping_done') }}",
                couponOk: "{{ trans('nm.coupon_ok') }}",
                couponErr: "{{ trans('nm.coupon_err') }}"
            }
        };
        document.documentElement.classList.add('js');
        /* light / dark: the shopper's choice, else the store default; set before paint so there is no flash */
        (function () {
            var d = document.documentElement, mode = "{{ include('components.nm.pick', {v: theme.settings.get('color_mode', 'light')})|trim ?: 'light' }}";
            try { mode = localStorage.getItem('nm-theme') || mode; } catch (e) {}
            if (mode === 'auto') mode = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            if (mode === 'dark') d.setAttribute('data-theme', 'dark');
        })();
        /* lite mode: weak phones and laptops, data saver, or a device that stuttered on an earlier visit
           get the same design with the decorative motion switched off (motion.js may also switch it on) */
        (function () {
            var d = document.documentElement, n = navigator, c = n.connection || {}, lite = false;
            if (c.saveData || /(^|-)2g$/.test(c.effectiveType || '')) lite = true;
            if (n.deviceMemory && n.deviceMemory <= 2) lite = true;
            if (n.hardwareConcurrency && n.hardwareConcurrency <= 2) lite = true;
            try { if (localStorage.getItem('nm-lite') === '1') lite = true; } catch (e) {}
            var level = "{{ include('components.nm.pick', {v: theme.settings.get('motion_level', 'full')})|trim ?: 'full' }}";
            if (level === 'calm' || level === 'still') lite = true;
            if (level === 'still') d.classList.add('nm-still');
            if (lite) d.classList.add('nm-lite');
        })();
    </script>

    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}{% endblock %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@200;300;400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
    {# Raed's styles first (other pages, Salla components), Nimo on top #}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">
    {% if __preview is not defined %}
        <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}"/>
    {% endif %}
    <link rel="stylesheet" href="{{ 'nm-app.css' | asset }}">

    <style>
        :root {
            --font-main: 'IBM Plex Sans Arabic';
            --color-primary: #EB6A1F;
            --color-primary-dark: #C4520F;
            --color-primary-light: #F49A5E;
            --color-primary-reverse: #FFFFFF;
        }
    </style>
    {% hook 'head:end' %}
</head>
{% set has_tabbar = theme.settings.get('show_bottom_nav', true) %}
<body id="app" class="nm theme-raed {{ theme.settings.get('show_scroll_progress', true) is same as(false) ? 'no-progress' : '' }} page-{{ page.slug|replace({'.': '-'}) }} {{ has_tabbar ? 'has-tabbar' : '' }} {% hook 'body:classes' %}">
{% hook 'body:start' %}
<a class="nm-sr" href="#main-content">{{ trans('nm.skip') }}</a>

{% component 'header.header' %}

<main id="main-content" role="main">
    {% block content %}{% endblock %}
</main>

{% component 'footer.footer' %}

{% include 'components.nm.cart-drawer' %}
{% include 'components.nm.popup' %}
{% include 'components.nm.floating' %}
{% if has_tabbar %}{% include 'components.nm.tabbar' %}{% endif %}

{% if __preview is not defined %}
    <script defer crossorigin="anonymous" src="{{ 'app.js' | asset }}"></script>
{% endif %}
<script defer src="{{ 'nm-app.js' | asset }}"></script>
{% block scripts %}{% endblock %}

{# Salla's own modals; the search buttons open <salla-search> via `search::open`. #}
<salla-search></salla-search>
{% if __preview is not defined %}
    <salla-offer-modal></salla-offer-modal>
    <salla-login-modal></salla-login-modal>
    {% if store.scope %}
        <salla-scopes selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
    {% endif %}
{% endif %}
{% hook 'body:end' %}
</body>
</html>
